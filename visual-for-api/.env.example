# На Linux эти два файла дают вариант со своей PostgreSQL.
# Для существующей БД оставь только compose.yml после подготовки секретов/ключей.
COMPOSE_FILE=compose.yml:compose.postgres.yml
COMPOSE_PATH_SEPARATOR=:
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
APP_SUBNET=172.30.87.0/24
WEB_INTERNAL_IP=172.30.87.10
LOCAL_UID=0
LOCAL_GID=0
